<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- The injected repository is an intentionally shared storage port.
       Copying it would defeat constructor injection and database identity. -->
  <Match>
    <Class name="de.appfabrik.garnbox.application.YarnService"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- Collection transfer services intentionally share their injected storage
       and file ports, just as YarnService shares its repository. -->
  <Match>
    <Class name="~de\.appfabrik\.garnbox\.application\.Collection(Export|Import)"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
